---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en" data-theme="halloween">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="h-screen overflow-hidden">

    <div class="h-full max-w-[1440px] mx-auto flex flex-col">

      <!-- Topbar -->
      <div class="navbar bg-base-300 border-b border-base-content/10 shrink-0 z-10 px-4">
        <label for="nav-drawer" class="btn btn-ghost btn-square lg:hidden">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <slot name="topbar" />
      </div>

      <!-- Body -->
      <div class="flex-1 overflow-hidden">
        <div class="drawer lg:drawer-open h-full">
          <input id="nav-drawer" type="checkbox" class="drawer-toggle" />

          <div class="drawer-content flex h-full overflow-hidden">

            <!-- Main content -->
            <main class="flex-1 overflow-y-auto p-8">
              <slot />
            </main>

            <!-- Right page nav — hidden below xl -->
            <aside class="hidden xl:block w-56 shrink-0 bg-base-200 border-l border-base-content/10 overflow-y-auto">
              <slot name="page-nav" />
            </aside>

          </div>

          <!-- Left nav drawer -->
          <div class="drawer-side z-20 h-full">
            <label for="nav-drawer" class="drawer-overlay"></label>
            <aside class="w-64 min-h-full bg-base-200 border-r border-base-content/10 overflow-y-auto">
              <slot name="nav" />
            </aside>
          </div>

        </div>
      </div>

    </div>

  </body>
</html>
